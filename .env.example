# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to GitHub.
# ─────────────────────────────────────────────────────────────

# ConvertKit (email list)
# Get from: app.convertkit.com → Account → API Keys
CONVERTKIT_API_KEY=your_api_key_here

# Get from: app.convertkit.com → Forms → Your form → Settings
CONVERTKIT_FORM_ID=your_form_id_here

# Site URL (used for OG tags and canonical URLs)
NEXT_PUBLIC_SITE_URL=https://limitlessintelligencesystems.com
